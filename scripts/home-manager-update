#!/bin/bash

set -e

if (( $# > 0 )); then
  echo "Usage: ${0##*/}" >&2
  exit 2
fi

SCRIPT_DIR=$(cd "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
flake_dir=$(readlink -f "${XDG_CONFIG_HOME:-$HOME/.config}/home-manager")
nix flake update --flake "$flake_dir"
exec "$SCRIPT_DIR/home-manager-switch" --flake "$flake_dir"
