#!/bin/bash

set -eo pipefail

if (( $# > 0 )); then
  echo "Usage: ${0##*/}" >&2
  exit 2
fi

if ! loaded_version=$(cat /sys/module/nvidia/version); then
  echo "No loaded NVIDIA driver found. Load the driver or reboot first." >&2
  exit 1
fi

if ! installed_version=$(dpkg-query -W -f='${db:Status-Status} ${Version}\n' \
  "libnvidia-gl-*:$(dpkg --print-architecture)" \
  | awk '$1 == "installed" { sub(/^[0-9]+:/, "", $2); sub(/-.*/, "", $2); print $2 }' \
  | sort -u); then
  echo "Could not determine the NVIDIA graphics library version installed by apt." >&2
  exit 1
fi
if [[ ! "$installed_version" =~ ^[0-9]+(\.[0-9]+)+$ ]]; then
  echo "Expected one installed NVIDIA graphics library version, found: $installed_version" >&2
  exit 1
fi

printf 'NVIDIA installed: %s\nNVIDIA loaded:    %s\n' "$installed_version" "$loaded_version"
if [[ "$loaded_version" != "$installed_version" ]]; then
  echo "NVIDIA versions differ. Reboot, then run this script again." >&2
  exit 1
fi

# An explicit version also works with NVIDIA's open kernel modules.
nix-env -iA nixgl.auto.nixGLDefault --argstr nvidiaVersion "$installed_version" -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/nixos-25.05.tar.gz

nixgl=$(command -v nixGL)
# Ignore libraries inherited from an older graphical session when checking the wrapper.
library_paths=$(env -u LD_LIBRARY_PATH -u __EGL_VENDOR_LIBRARY_FILENAMES \
  "$nixgl" printenv LD_LIBRARY_PATH __EGL_VENDOR_LIBRARY_FILENAMES)
wrapper_versions=$(printf '%s\n' "$library_paths" | tr ':' '\n' \
  | sed -nE 's@.*/[^/]*-nvidia-x11-([0-9.]+)-nixGL(/|-).*@\1@p' | sort -u)
if [[ "$wrapper_versions" != "$installed_version" ]]; then
  echo "nixGL selects ${wrapper_versions:-no NVIDIA libraries}; expected $installed_version." >&2
  echo "Wrapper: $(readlink -f "$nixgl")" >&2
  exit 1
fi

printf 'nixGL: %s\nVerified NVIDIA %s in apt, the loaded module, and nixGL library paths.\n' \
  "$(readlink -f "$nixgl")" "$installed_version"
echo "Start a fresh graphical session to use the updated libraries."
