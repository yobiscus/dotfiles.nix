#!/bin/bash

set -eo pipefail

has_config_arg=false
for arg in "$@"; do
  case "$arg" in
    --flake|-f|--file) has_config_arg=true; break ;;
  esac
done

switch_args=(--impure)
config_flake="${XDG_CONFIG_HOME:-$HOME/.config}/home-manager/flake.nix"
if [[ $has_config_arg == false && ! -v HOME_MANAGER_CONFIG && -f "$config_flake" ]]; then
  flake_dir=$(dirname -- "$(readlink -f "$config_flake")")
  # Enable submodules before Nix resolves self, so dirty submodules are included.
  switch_args+=(--flake "$flake_dir?submodules=1")
fi

switch_args+=("$@")

for arg in "$@"; do
  case "$arg" in
    -n|--dry-run|-h|--help|--version)
      exec home-manager switch "${switch_args[@]}"
      ;;
  esac
done

before=$(home-manager generations 2>/dev/null | awk '/\(current\)$/ { print $7 }' || true)
home-manager switch "${switch_args[@]}"
after=$(home-manager generations | awk '/\(current\)$/ { print $7 }' || true)

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
if ! { mkdir -p "$state_dir" && printf '%s\n' "$before" "$after" > "$state_dir/home-manager-last-switch"; }; then
  echo "Home Manager switched successfully, but saving the generation diff failed." >&2
  exit 0
fi

SCRIPT_DIR=$(cd "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
if ! "$SCRIPT_DIR/home-manager-diff-last"; then
  echo "Home Manager switched successfully, but the generation diff failed." >&2
fi
